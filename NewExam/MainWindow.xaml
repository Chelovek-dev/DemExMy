<Window x:Class="NewExam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewExam"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Button Visibility="Collapsed" Click="AddTovarClick" Name="AddTovarBTN" Content="Добавить товар" Margin="110,50" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Visibility="Collapsed" Click="ZakazClick" Name="ZakazBTN" Content="Заказы" Margin="110,80" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Visibility="Collapsed" Name="FilterPanel" VerticalAlignment="Top" Margin="0,100" Height="70">
            <TextBox Name="SearchTB" TextChanged="SearchTB_TextChanged"/>
            <StackPanel Orientation="Horizontal" >
                <ComboBox Name="PostavshikCombo" SelectionChanged="PostavshikCombo_SelectionChanged" Width="150"/>
                <Button Click="ASC" Name="ASCBTN" Content="Вверх" Margin="10,0"/>
                <Button Click="DESC" Name="DESCBTN" Content="Вниз" />
            </StackPanel>
        </StackPanel>

        <Image Source="/Images/Icon.JPG" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="Кроссовки" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label Content="User" Name="UserName"  HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Button Click="ExitBTN" Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="50"/>
        <ScrollViewer Margin="0,180,0,0">
            <StackPanel Name="KrossovkiPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
