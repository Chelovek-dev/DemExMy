<Window x:Class="NewExam.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewExam"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <Label Content="Авторизация" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="30"/>
        <StackPanel Width="200" HorizontalAlignment="Center"   VerticalAlignment="Center">
            <TextBox Name="LoginTXT" Margin="10" Text="admin"/>
            <TextBox Name="PasswordTXT" Margin="10" Text="admin"/>
            <Button Click="LoginBTN" Content="Войти" Margin="10"/>
            <Button Click="GuestBTN" Content="Войти как гость" Margin="10"/>
            <Label Name="lblError" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>
