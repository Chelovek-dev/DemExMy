<Window x:Class="NewExam.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewExam"
        mc:Ignorable="d"
        Title="Заказы" Height="450" Width="800">
    <Grid>
        <Label Content="Заказы" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="30"/>
        <ScrollViewer Margin="0,55,0,45">
            <StackPanel Name="OrdersPanel"/>
        </ScrollViewer>
        <Button Content="Назад" Click="BackClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Width="50"/>
    </Grid>
</Window>
